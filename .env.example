# Copy to .env locally. Never commit real credentials.
# Configure secrets in the deployment provider for production.

# Set ONE provider key:
OPENAI_API_KEY=
# LOVABLE_API_KEY=

# Optional provider model override.
# OpenAI default: gpt-4.1-mini
# Lovable Gateway default: openai/gpt-4.1-mini
ISABELLA_PUBLIC_MODEL=
